# Generated files are written with LF by the tooling; keep them LF on every OS so the
# CI "map must be current" diff never fails on line endings alone.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf

# Copied in by the Postman CLI, not written here: GitHub collapses them in a PR, and `heimdall review` leaves
# them out of what Jev judges.
postman/skills/** linguist-vendored
.postman/skills.json linguist-vendored
