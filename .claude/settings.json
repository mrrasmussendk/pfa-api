{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python -m heimdall hook" }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/finish.py",
            "timeout": 900,
            "statusMessage": "Running pytest, the e2e scenarios and heimdall review before finishing"
          }
        ]
      }
    ]
  }
}
