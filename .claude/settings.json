{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/python.sh\" -m heimdall hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/python.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/finish.py\"",
            "timeout": 900,
            "statusMessage": "Running pytest, the change's checks, the e2e scenarios and heimdall review before finishing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/finish.py",
            "timeout": 600,
            "statusMessage": "Running pytest and heimdall review before finishing"
          }
        ]
      }
    ]
  }
}
