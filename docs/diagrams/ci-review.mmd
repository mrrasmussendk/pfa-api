flowchart TB
    accTitle: PR review workflow outcomes
    pr["Non-draft pull request"]:::input
    map["Generate current slice map"]:::process
    key{"TYPESAFE_API_KEY available?"}:::decision
    skipped["Review skipped<br/>Comment explains why; check passes"]:::output
    run["Run heimdall review<br/>Save reports and update PR comment"]:::process
    outcome{"Review result?"}:::decision
    pass["approve / comment<br/>Check passes"]:::output
    fail["request_changes<br/>Check fails"]:::decision
    human["escalate<br/>Warning and needs-human-review label"]:::decision
    error["Review could not run<br/>Check fails"]:::decision
    pr --> map --> key
    key -->|No| skipped
    key -->|Yes| run --> outcome
    outcome --> pass
    outcome --> fail
    outcome --> human
    outcome --> error
    classDef input fill:#eff6ff,stroke:#2563eb,color:#172554
    classDef process fill:#f0fdfa,stroke:#0f766e,color:#134e4a
