flowchart TB
    accTitle: PR review: inputs, judgment, policy and outputs
    diff["PR diff<br/>base...HEAD"]:::input
    map["Feature map<br/>.heimdall/map.json"]:::input
    task["Task<br/>PR title and body"]:::input
    tree["Working tree<br/>each edited application file, whole"]:::input
    state["Heimdall builds bounded state<br/>Diff, architecture and computed facts"]:::process
    craft["Craft pass<br/>One call per file: clean code on the whole file"]:::process
    jev["Jev API<br/>Answers typed review questions"]:::process
    policy["Policy in code<br/>Applies thresholds and gates"]:::decision
    verdict["Outcome<br/>approve / comment<br/>request_changes / escalate"]:::output
    reports["Review artifacts<br/>JSON, Markdown and telemetry"]:::output
    comment["Workflow updates the PR comment<br/>and check status"]:::output
    diff --> state
    map --> state
    task --> state
    diff --> craft
    tree --> craft
    state --> jev
    craft --> jev
    jev --> policy --> verdict
    verdict --> reports --> comment
