    model["Load embedding model<br/>Background thread"]:::process
    ready["GET /ready: 200<br/>Tokenizer and model loaded"]:::output
    traffic["Readiness probe allows traffic"]:::output
    failed["Log warm-up failure<br/>GET /ready remains 503"]:::decision
