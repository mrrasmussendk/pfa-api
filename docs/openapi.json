    "/ready": {
      "get": {
        "description": "Readiness: every heavy component is loaded, so a request will be served without a\ncold start. 503 problem document while loading — route traffic elsewhere until 200.\nReads flags only; it never triggers a load itself.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "components": {
                    "embedding_model": true,
                    "tokenizer": true
                  },
                  "status": "ready"
                },
                "schema": {
                  "$ref": "#/components/schemas/ReadyOut"
                }
              }
            },
            "description": "Every heavy component is in memory; a request is served without a cold start"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "loading": {
                    "summary": "Service not ready",
                    "value": {
                      "components": {
                        "embedding_model": false,
                        "tokenizer": true
                      },
                      "detail": "still loading: embedding_model",
                      "instance": "/ready",
                      "status": 503,
                      "title": "Service not ready",
                      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
                      "type": "urn:pfa-api:problem:not-ready"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Still loading: route traffic elsewhere and poll again after `Retry-After` seconds; `components` says what is pending",
            "headers": {
              "Cache-Control": {
                "description": "`no-store`: a probe is never cached",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Seconds until the next poll",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "internal_error": {
                    "summary": "Internal Server Error",
                    "value": {
                      "instance": "/ready",
                      "status": 500,
                      "title": "Internal Server Error",
                      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
                      "type": "about:blank"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Any other error (RFC 9457 problem details)"
          }
        },
        "summary": "Readiness",
        "tags": [
          "service"
        ]
      }
    }
  },
